# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for config and code files
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Extensionless dot-files
.yamllint text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
